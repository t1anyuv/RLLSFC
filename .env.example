# 项目环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 项目根目录（通常自动检测，无需设置）
# PROJECT_ROOT=/path/to/LearnedTShape

# 资源文件基础目录（相对于项目根目录或绝对路径）
# RESOURCE_BASE_DIR=src/resource

# TDrive数据集目录
# Windows示例：
# TDRIVE_DATA_DIR=D:\Dataset\Trajectory\TDrive\clean_test
# Linux/Mac示例：
# TDRIVE_DATA_DIR=/data/trajectory/TDrive/clean_test

# TDrive数据集文件路径（如果不设置，将自动从TDRIVE_DATA_DIR推断）
# Windows示例：
# TDRIVE_DATA_PATH=D:\Dataset\Trajectory\TDrive\clean_test\tdrive_cleaned.txt
# Linux/Mac示例：
# TDRIVE_DATA_PATH=/data/trajectory/TDrive/clean_test/tdrive_cleaned.txt

# PyTorch相关
# KMP_DUPLICATE_LIB_OK=TRUE
